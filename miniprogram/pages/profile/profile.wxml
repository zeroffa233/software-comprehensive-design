<view class="container">
  <!-- 未登录态 -->
  <view class="card profile-head" wx:if="{{!logged}}">
    <view class="avatar avatar-empty">未登录</view>
    <view class="head-info">
      <view class="head-name">游客</view>
      <view class="muted">登录后可发布商品、下单购买</view>
    </view>
    <button class="btn btn-ghost head-login-btn" size="mini" bindtap="goLogin">去登录</button>
  </view>

  <block wx:if="{{logged && me}}">
    <!-- 资料区 -->
    <view class="card profile-head">
      <view class="avatar-box" bindtap="chooseAvatar">
        <image class="avatar-img" wx:if="{{me.avatar}}" src="{{me.avatar}}" mode="aspectFill" />
        <view class="avatar-img avatar-placeholder" wx:else>无头像</view>
        <view class="avatar-edit" wx:if="{{uploadingAvatar}}">上传中…</view>
      </view>
      <view class="head-info">
        <view class="head-name">{{me.nickname}}</view>
        <view class="muted">{{me.phone}} ｜ {{roleText}}</view>
        <view class="muted" wx:if="{{me.createTime}}">注册于 {{me.createTime}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">编辑资料</view>
      <view class="form-item">
        <label class="form-label">头像（jpg/png，≤2MB，点击上方头像更换）</label>
      </view>
      <view class="form-item">
        <label class="form-label">昵称（2-20 字符）</label>
        <input class="form-input" maxlength="20" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNickname" />
      </view>
      <view class="form-item">
        <label class="form-label">个性签名</label>
        <input class="form-input" maxlength="50" placeholder="如：毕业出物，诚心交易" value="{{signature}}" bindinput="onSignature" />
      </view>
      <view class="form-item">
        <label class="form-label">手机号（账号标识，不可修改）</label>
        <input class="form-input" value="{{me.phone}}" disabled />
      </view>
      <button class="btn btn-primary" bindtap="saveProfile" disabled="{{savingProfile}}">
        {{savingProfile ? '保存中…' : '保存资料'}}
      </button>
    </view>

    <view class="card">
      <view class="section-title">修改密码</view>
      <view class="form-item">
        <label class="form-label">原密码</label>
        <input class="form-input" password placeholder="请输入原密码" value="{{oldPassword}}" bindinput="onOldPassword" />
      </view>
      <view class="form-item">
        <label class="form-label">新密码（8-20 位，含字母和数字）</label>
        <input class="form-input" password placeholder="请设置新密码" value="{{newPassword}}" bindinput="onNewPassword" />
      </view>
      <view class="form-item">
        <label class="form-label">确认新密码</label>
        <input class="form-input" password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPassword" />
      </view>
      <button class="btn btn-primary" bindtap="changePassword" disabled="{{changingPwd}}">
        {{changingPwd ? '提交中…' : '修改密码'}}
      </button>
      <view class="form-hint">修改成功后其他设备会话将失效，本机保持登录。</view>
    </view>

    <!-- 入口区 -->
    <view class="card">
      <view class="entry" bindtap="goGoodsMine">
        <text>我的商品</text>
        <text class="entry-arrow">›</text>
      </view>
      <view class="divider"></view>
      <view class="entry" bindtap="goOrderList">
        <text>我的订单</text>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <view class="card">
      <button class="btn btn-danger" bindtap="logout">退出登录（清除 Token 与会话）</button>
    </view>
  </block>
</view>
