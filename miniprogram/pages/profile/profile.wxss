.profile-head {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}
.avatar-box {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eef0f3;
}
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a0a5ad;
  font-size: 24rpx;
}
.avatar-empty {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eef0f3;
  color: #a0a5ad;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-edit {
  position: absolute;
  left: 0;
  bottom: -6rpx;
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 8rpx;
}
.head-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.head-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.head-login-btn {
  flex-shrink: 0;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 8rpx;
  font-size: 30rpx;
}
.entry-arrow {
  color: #c0c4cc;
  font-size: 36rpx;
}
