<view class="agent-page">
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="msg-row {{item.role === 'user' ? 'msg-user' : 'msg-bot'}}" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-bot'}}">
        <text>{{item.text}}</text>
        <view class="skill-tag" wx:if="{{item.skillName}}">Skill：{{item.skillName}}</view>
      </view>
    </view>
    <view class="msg-row msg-bot" wx:if="{{sending}}">
      <view class="bubble bubble-bot bubble-typing">对方正在输入…</view>
    </view>
    <view class="msg-bottom"></view>
  </scroll-view>

  <view class="input-bar">
    <input class="form-input chat-input" placeholder="问我任何平台相关问题…" value="{{inputValue}}" bindinput="onInput" confirm-type="send" bindconfirm="send" />
    <button class="btn btn-primary chat-send-btn {{sending ? 'disabled' : ''}}" size="mini" bindtap="send" disabled="{{sending}}">发送</button>
  </view>
</view>
