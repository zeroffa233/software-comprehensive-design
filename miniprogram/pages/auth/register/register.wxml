<view class="container">
  <view class="card reg-card">
    <view class="reg-title">注册新账号</view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>手机号（11 位，全平台唯一）</label>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    </view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>短信验证码（5 分钟内有效）</label>
      <view class="sms-row">
        <input class="form-input sms-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{smsCode}}" bindinput="onSmsCode" />
        <button class="btn btn-ghost sms-btn {{countdown > 0 ? 'disabled' : ''}}" size="mini" bindtap="sendSms" disabled="{{countdown > 0}}">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
      <view class="form-hint" wx:if="{{devCode}}">dev 模式验证码：{{devCode}}</view>
    </view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>密码（8-20 位，含字母和数字）</label>
      <input class="form-input" password placeholder="请设置密码" value="{{password}}" bindinput="onPassword" />
    </view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>确认密码</label>
      <input class="form-input" password placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPassword" />
    </view>

    <view class="form-item agree-row">
      <checkbox-group bindchange="onAgreed">
        <label>
          <checkbox value="agree" checked="{{agreed}}" />
          <text class="agree-text">同意《平台使用协议》</text>
        </label>
      </checkbox-group>
    </view>

    <button class="btn btn-primary" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '注册中…' : '注册（成功后自动登录）'}}
    </button>

    <view class="reg-links">
      <text class="muted">已有账号？</text>
      <text class="link" bindtap="goLogin">去登录</text>
    </view>
  </view>
</view>
