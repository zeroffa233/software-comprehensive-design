<view class="container">
  <view class="card fp-card">
    <view class="fp-title">找回密码</view>
    <view class="form-hint fp-tip">仅向注册绑定手机号发送验证码；重置成功后旧会话全部失效，需重新登录。</view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>手机号</label>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    </view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>短信验证码（6 位，5 分钟有效）</label>
      <view class="sms-row">
        <input class="form-input sms-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{smsCode}}" bindinput="onSmsCode" />
        <button class="btn btn-ghost sms-btn {{countdown > 0 ? 'disabled' : ''}}" size="mini" bindtap="sendSms" disabled="{{countdown > 0}}">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
      <view class="form-hint" wx:if="{{devCode}}">dev 模式验证码：{{devCode}}</view>
    </view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>新密码（8-20 位，含字母和数字）</label>
      <input class="form-input" password placeholder="请设置新密码" value="{{newPassword}}" bindinput="onNewPassword" />
    </view>

    <view class="form-item">
      <label class="form-label"><text class="req">*</text>确认新密码</label>
      <input class="form-input" password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPassword" />
    </view>

    <button class="btn btn-primary" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '重置密码'}}
    </button>

    <view class="fp-links">
      <text class="link" bindtap="goLogin">返回登录页</text>
    </view>
  </view>
</view>
