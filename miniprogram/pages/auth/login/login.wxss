.login-card {
  padding: 48rpx 40rpx;
  margin-top: 60rpx;
}
.login-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  color: #0a66c2;
  margin-bottom: 40rpx;
}
.tabs {
  display: flex;
  margin-bottom: 32rpx;
  border-bottom: 2rpx solid #eef0f3;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #6b7078;
  font-size: 30rpx;
}
.tab-active {
  color: #0a66c2;
  font-weight: 600;
  border-bottom: 4rpx solid #0a66c2;
  margin-bottom: -2rpx;
}
.sms-row {
  display: flex;
  align-items: center;
}
.sms-input {
  flex: 1;
}
.sms-btn {
  margin-left: 16rpx;
  flex-shrink: 0;
}
.submit-btn {
  margin-top: 48rpx;
}
.login-links {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
}
.login-foot {
  text-align: center;
  margin-top: 40rpx;
  padding: 0 40rpx;
  line-height: 1.6;
}
