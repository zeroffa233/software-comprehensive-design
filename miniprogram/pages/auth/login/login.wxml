<view class="container">
  <view class="card login-card">
    <view class="login-title">校园二手交易平台</view>

    <view class="tabs">
      <view class="tab {{tab === 'password' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="password">密码登录</view>
      <view class="tab {{tab === 'sms' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="sms">验证码登录</view>
    </view>

    <view class="form-item">
      <label class="form-label">手机号</label>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    </view>

    <view class="form-item" wx:if="{{tab === 'password'}}">
      <label class="form-label">密码</label>
      <input class="form-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPassword" />
    </view>

    <block wx:if="{{tab === 'sms'}}">
      <view class="form-item">
        <label class="form-label">短信验证码</label>
        <view class="sms-row">
          <input class="form-input sms-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{smsCode}}" bindinput="onSmsCode" />
          <button class="btn btn-ghost sms-btn {{countdown > 0 ? 'disabled' : ''}}" size="mini" bindtap="sendSms" disabled="{{countdown > 0}}">
            {{countdown > 0 ? countdown + 's' : '获取验证码'}}
          </button>
        </view>
      </view>
      <view class="form-hint" wx:if="{{devCode}}">dev 模式验证码：{{devCode}}</view>
    </block>

    <button class="btn btn-primary submit-btn" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '登录中…' : '登录'}}
    </button>

    <view class="login-links">
      <text class="link" bindtap="goRegister">注册新账号</text>
      <text class="muted"> ｜ </text>
      <text class="link" bindtap="goFindPwd">忘记密码</text>
    </view>
  </view>

  <view class="login-foot muted">
    连续输错 5 次锁定 30 分钟；封禁账号将提示原因与申诉入口。
  </view>
</view>
