# =====================================================================
# 环境变量模板（只放变量名与说明，不放任何真实密钥）
#   - server-fastapi：复制为 server-fastapi/.env（python-dotenv 自动加载）
#   - server-springboot：这些变量直接读进程环境变量（IDE/命令行/容器注入）
# 本地开发不配置也能跑：application.yml 与 config.py 里有 dev 默认值。
# =====================================================================

# --- 数据库：两个服务共用同一个库 -------------------------------------
DB_URL=mysql+pymysql://root:<db-password>@127.0.0.1:3306/campus_market?charset=utf8mb4
# SpringBoot 侧对应项（Spring 不读 DB_URL，改用下面三项）
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/campus_market?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<db-password>

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379

# --- JWT：两个服务必须一致；非 dev profile 下长度 <32 或留空会启动失败
JWT_SECRET=<至少 32 字节的随机字符串>

# --- SpringBoot 专项 ---------------------------------------------------
# 商品图片落盘目录（默认 ./uploads，/images/** 静态映射）
UPLOAD_DIR=./uploads
# Agent 服务地址（FastAPI）
AGENT_BASE_URL=http://127.0.0.1:8100
# agent-svc 服务账号（仅签发只读服务令牌，不入库；生产请改为内网密钥）
AGENT_SVC_PHONE=13800000000
AGENT_SVC_PASSWORD=<agent-svc-password>

# --- FastAPI 专项 ------------------------------------------------------
SPRINGBOOT_BASE_URL=http://127.0.0.1:8080
# 大模型（不配置则自动降级为规则引擎；视觉能力同样走这套配置）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=doubao-seed-2.0-mini
